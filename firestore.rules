rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Token → household lookup for invite links (no household enumeration)
    match /invites/{token} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['household_id', 'name', 'created_by', 'invite_token'])
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.invite_token == token;
      allow delete: if signedIn();
    }

    match /households/{householdId} {
      function isMember() {
        return signedIn() &&
          exists(/databases/$(database)/documents/households/$(householdId)/household_members/$(request.auth.uid));
      }

      function isCreator() {
        return signedIn() && (
          resource.data.created_by == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        );
      }

      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid;
      allow read, update, delete: if isMember() || isCreator();

      match /household_members/{memberId} {
        allow read: if isMember() || (signedIn() && request.auth.uid == memberId);
        allow create: if signedIn()
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.household_id == householdId;
        allow update, delete: if isMember() || (signedIn() && request.auth.uid == memberId);
      }

      match /expenses/{document} {
        allow read, write: if isMember();
      }
      match /expense_splits/{document} {
        allow read, write: if isMember();
      }
      match /line_items/{document} {
        allow read, write: if isMember();
      }
      match /settlements/{document} {
        allow read, write: if isMember();
      }
    }
  }
}
